# --- Supabase (Project Settings -> API in your Supabase dashboard) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-KEEP-SECRET

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Web Push (generate with: npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=paste-public-key-here
VAPID_PRIVATE_KEY=paste-private-key-here-KEEP-SECRET
PUSH_CONTACT_EMAIL=you@youragency.com

# --- Session security ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=paste-a-long-random-string-here

# --- Super admin (you only — never share this) ---
SUPER_ADMIN_CODE=choose-a-long-random-string-here
